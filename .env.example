# Copy to .env and edit. Every value here is optional: the defaults are the
# ones the server is designed around, and .env is gitignored.
#
# NOTE: no secret belongs in this file. The OAuth client secret stays in its
# own JSON file (see CLOUDTUBE_CLIENT_SECRET_FILE) and the user's tokens are
# written to the state directory. Keeping secrets out of the environment keeps
# them out of `ps` output and out of crash dumps.

# --- Paths -----------------------------------------------------------------
# Where the OAuth desktop-client JSON downloaded from Google Cloud lives.
CLOUDTUBE_CLIENT_SECRET_FILE=.secrets/client_secret.json

# Where tokens and the upload history database are kept. Defaults to
# %LOCALAPPDATA%\cloudtube-mcp on Windows, ~/.cloudtube-mcp elsewhere --
# deliberately outside the repository.
# CLOUDTUBE_STATE_DIR=

# --- Behaviour --------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
CLOUDTUBE_LOG_LEVEL=INFO

# Route uploads to an in-process fake instead of YouTube. Use this to
# demonstrate or test the failure paths without spending quota. Nothing is
# published while this is true.
CLOUDTUBE_FAKE_YOUTUBE=false

# --- Limits -----------------------------------------------------------------
# Largest amount read_file will return, in bytes.
CLOUDTUBE_MAX_READ_BYTES=1048576

# Refuse uploads larger than this before downloading anything.
CLOUDTUBE_MAX_UPLOAD_BYTES=10737418240

# Resumable upload chunk size. Must be a multiple of 262144 (256 KiB).
# Smaller means more round trips but less work lost to a dropped connection.
CLOUDTUBE_UPLOAD_CHUNK_BYTES=8388608

# --- Timeouts and retries -----------------------------------------------------
CLOUDTUBE_REQUEST_TIMEOUT_SECONDS=30
CLOUDTUBE_UPLOAD_DEADLINE_SECONDS=3600
CLOUDTUBE_MAX_RETRIES=4

# --- HTTP transport (ChatGPT) ---------------------------------------------------
# Only used with --transport http. Keep the host on loopback: this process
# holds a live Google OAuth token, and a tunnel should be the only thing in
# front of it.
CLOUDTUBE_HTTP_HOST=127.0.0.1
CLOUDTUBE_HTTP_PORT=8077
